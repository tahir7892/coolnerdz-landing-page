# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True

# Email (waitlist confirmation + admin notification).
# Waitlist emails are skipped, with a logged warning, while EMAIL_HOST is empty.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
# Use TLS (STARTTLS, usually port 587) or SSL (usually port 465), never both.
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=hello@coolnerdz.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=CoolNerdz <hello@coolnerdz.com>
ADMIN_EMAIL=admin@example.com
SITE_URL=https://coolnerdz.com
