[Unit]
Description=CoolNerdz Django app (Gunicorn)
After=network.target

[Service]
User=coolnerdz
Group=www-data
WorkingDirectory=/opt/coolnerdz-landing-page
EnvironmentFile=/opt/coolnerdz-landing-page/.env
# /run/coolnerdz is created as coolnerdz:www-data so Nginx can reach the socket.
RuntimeDirectory=coolnerdz
RuntimeDirectoryMode=0750
ExecStart=/opt/coolnerdz-landing-page/env/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/coolnerdz/gunicorn.sock \
    --umask 007 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    coolnerdz.wsgi:application
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
